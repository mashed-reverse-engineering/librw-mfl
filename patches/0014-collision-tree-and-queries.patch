+// RpCollision pieces (collision kd tree plugin 0x11D, intersection queries). Clean-room: written from
+// MashedFormats/FORMATS.md + rwscene.py (read_colltree) + the shipped data, API names only from the game's imports.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <vector>
+#include <algorithm>
+
+#include "rwbase.h"
+#include "rwerror.h"
+#include "rwplg.h"
+#include "rwpipeline.h"
+#include "rwobjects.h"
+#include "rwengine.h"
+#include "rwcollision.h"
+
+#define PLUGIN_ID ID_COLLISION
+
+namespace rw {
+
+//
+// Tree storage / blob
+//
+
+static const uint32 STAMP = 0x1C02000A;	// library stamp of the game's data
+static const uint32 CHUNK_COLLTREE = 0x2C;
+
+static void put32(uint8 *&p, uint32 v) { memcpy(p, &v, 4); p += 4; }
+static void putF(uint8 *&p, float32 v) { memcpy(p, &v, 4); p += 4; }
+static uint32 get32(const uint8 *p) { uint32 v; memcpy(&v, p, 4); return v; }
+static float32 getF(const uint8 *p) { float32 v; memcpy(&v, p, 4); return v; }
+
+static CollisionTree*
+allocTree(uint32 nent, uint32 nsplit, bool map)
+{
+	CollisionTree *t = rwNewT(CollisionTree, 1, MEMDUR_EVENT | ID_COLLISION);
+	if(t == nil)
+		return nil;
+	memset(t, 0, sizeof(*t));
+	t->numEntries = nent;
+	t->numSplits = nsplit;
+	if(nsplit){
+		t->splits = rwNewT(CollSplit, nsplit, MEMDUR_EVENT | ID_COLLISION);
+		if(t->splits == nil){ t->destroy(); return nil; }
+	}
+	if(map){
+		t->flags |= CollisionTree::HASMAP;
+		if(nent){
+			t->map = rwNewT(uint16, nent, MEMDUR_EVENT | ID_COLLISION);
+			if(t->map == nil){ t->destroy(); return nil; }
+		}
+	}
+	return t;
+}
+
+void
+CollisionTree::destroy(void)
+{
+	rwFree(this->splits);
+	rwFree(this->map);
+	rwFree(this);
+}
+
+CollisionTree*
+CollisionTree::clone(void) const
+{
+	CollisionTree *t = allocTree(this->numEntries, this->numSplits, (this->flags & HASMAP) != 0);
+	if(t == nil)
+		return nil;
+	t->flags = this->flags;
+	t->bbox = this->bbox;
+	if(this->numSplits)
+		memcpy(t->splits, this->splits, sizeof(CollSplit)*this->numSplits);
+	if(this->map)
+		memcpy(t->map, this->map, 2*this->numEntries);
+	return t;
+}
+
+uint32
+CollisionTree::blobSize(void) const
+{
+	return 4 + 12 + 12 + 36 + 16*this->numSplits + ((this->flags & HASMAP) ? 2*this->numEntries : 0);
+}
+
+void
+CollisionTree::toBlob(uint8 *p) const
+{
+	uint32 st = blobSize() - 4 - 12 - 12;
+	put32(p, VERSION);
+	put32(p, CHUNK_COLLTREE); put32(p, st + 12); put32(p, STAMP);
+	put32(p, ID_STRUCT); put32(p, st); put32(p, STAMP);
+	put32(p, this->flags);
+	putF(p, bbox.inf.x); putF(p, bbox.inf.y); putF(p, bbox.inf.z);
+	putF(p, bbox.sup.x); putF(p, bbox.sup.y); putF(p, bbox.sup.z);
+	put32(p, this->numEntries);
+	put32(p, this->numSplits);
+	for(uint32 i = 0; i < this->numSplits; i++){
+		const CollNode *n[2] = { &splits[i].left, &splits[i].right };
+		for(int k = 0; k < 2; k++){
+			*p++ = n[k]->type;
+			*p++ = n[k]->contents;
+			memcpy(p, &n[k]->index, 2); p += 2;
+			putF(p, n[k]->value);
+		}
+	}
+	if(this->flags & HASMAP){
+		memcpy(p, this->map, 2*this->numEntries);
+	}
+}
+
+static bool
+nodeOk(const CollNode &n, uint32 nent, uint32 nsplit)
+{
+	if((n.type & ~1) != 0 && (n.type & ~1) != 4 && (n.type & ~1) != 8)
+		return false;
+	if(n.value != n.value)
+		return false;
+	if(n.contents == CollisionTree::SPLIT)
+		return n.index < nsplit;
+	return (uint32)n.index + n.contents <= nent;
+}
+
+// splits must form a tree rooted at 0: each referenced exactly once, depth limited
+static bool
+treeOk(const CollisionTree *t)
+{
+	if(t->numSplits == 0)
+		return true;
+	std::vector<uint8> seen(t->numSplits, 0);
+	std::vector<std::pair<uint32,int> > stack;
+	stack.push_back(std::make_pair(0u, 1));
+	seen[0] = 1;
+	uint32 count = 0;
+	while(!stack.empty()){
+		uint32 si = stack.back().first;
+		int depth = stack.back().second;
+		stack.pop_back();
+		count++;
+		if(depth > CollisionTree::MAXDEPTH)
+			return false;
+		const CollNode *n[2] = { &t->splits[si].left, &t->splits[si].right };
+		for(int k = 0; k < 2; k++)
+			if(n[k]->contents == CollisionTree::SPLIT){
+				if(seen[n[k]->index])
+					return false;
+				seen[n[k]->index] = 1;
+				stack.push_back(std::make_pair((uint32)n[k]->index, depth+1));
+			}
+	}
+	return count == t->numSplits;
+}
+
+CollisionTree*
+CollisionTree::fromBlob(const uint8 *b, uint32 size, int32 numTriangles)
+{
+	const char *err = "invalid collision tree";
+	if(b == nil || size < 4+12+12+36 || numTriangles < 0 || numTriangles > 65536 ||
+	   get32(b) != VERSION || get32(b+4) != CHUNK_COLLTREE || (uint64)get32(b+8) + 16 != size ||
+	   get32(b+16) != ID_STRUCT || (uint64)get32(b+20) + 12 != get32(b+8)){
+		RWERROR((ERR_GENERAL, err));
+		return nil;
+	}
+	const uint8 *s = b + 28;
+	uint32 slen = get32(b+20);
+	uint32 flags = get32(s);
+	uint32 nent = get32(s+28), nsplit = get32(s+32);
+	if((flags & ~1u) || nent != (uint32)numTriangles || nsplit > 65536 || (nent && nsplit == 0) ||
+	   slen != 36 + 16*(uint64)nsplit + ((flags & 1) ? 2*(uint64)nent : 0)){
+		RWERROR((ERR_GENERAL, err));
+		return nil;
+	}
+	CollisionTree *t = allocTree(nent, nsplit, (flags & 1) != 0);
+	if(t == nil)
+		return nil;
+	t->flags = flags;
+	t->bbox.inf.set(getF(s+4), getF(s+8), getF(s+12));
+	t->bbox.sup.set(getF(s+16), getF(s+20), getF(s+24));
+	bool ok = true;
+	const uint8 *p = s + 36;
+	for(uint32 i = 0; i < nsplit; i++){
+		CollNode *n[2] = { &t->splits[i].left, &t->splits[i].right };
+		for(int k = 0; k < 2; k++){
+			n[k]->type = p[0];
+			n[k]->contents = p[1];
+			memcpy(&n[k]->index, p+2, 2);
+			n[k]->value = getF(p+4);
+			p += 8;
+			ok = ok && nodeOk(*n[k], nent, nsplit);
+		}
+	}
+	if(flags & 1){
+		memcpy(t->map, p, 2*nent);
+		for(uint32 i = 0; i < nent; i++)
+			ok = ok && t->map[i] < nent;
+	}
+	if(!ok || !treeOk(t)){
+		t->destroy();
+		RWERROR((ERR_GENERAL, err));
+		return nil;
+	}
+	return t;
+}
+
+//
+// Builder
+//
+
+struct Builder
+{
+	const V3d *v;
+	const Triangle *t;
+	std::vector<uint16> order;
+	std::vector<float32> lo, hi, cen;	// 3 per triangle
+	std::vector<CollSplit> splits;
+	int32 maxLeaf;
+	float32 binf[3], bsup[3];
+};
+
+static CollNode makeNode(Builder &b, int32 s, int32 e, int axis, bool left, float32 value);
+
+static uint32
+splitRange(Builder &b, int32 s, int32 e)
+{
+	uint32 idx = b.splits.size();
+	b.splits.push_back(CollSplit());
+	float32 cl[3] = { 1e30f, 1e30f, 1e30f }, ch[3] = { -1e30f, -1e30f, -1e30f };
+	for(int32 i = s; i < e; i++)
+		for(int a = 0; a < 3; a++){
+			float32 c = b.cen[3*b.order[i]+a];
+			cl[a] = std::min(cl[a], c); ch[a] = std::max(ch[a], c);
+		}
+	int axis = 0;
+	for(int a = 1; a < 3; a++)
+		if(ch[a]-cl[a] > ch[axis]-cl[axis])
+			axis = a;
+	int32 mid = s + (e-s)/2;
+	if(mid > s && mid < e){
+		const std::vector<float32> &cen = b.cen;
+		std::nth_element(b.order.begin()+s, b.order.begin()+mid, b.order.begin()+e,
+			[&cen, axis](uint16 x, uint16 y){ return cen[3*x+axis] < cen[3*y+axis] || (cen[3*x+axis] == cen[3*y+axis] && x < y); });
+	}
+	float32 lv = (&b.binf[0])[axis], rv = (&b.bsup[0])[axis];
+	bool any = false;
+	for(int32 i = s; i < mid; i++){
+		float32 h = b.hi[3*b.order[i]+axis];
+		lv = any ? std::max(lv, h) : h; any = true;
+	}
+	any = false;
+	for(int32 i = mid; i < e; i++){
+		float32 l = b.lo[3*b.order[i]+axis];
+		rv = any ? std::min(rv, l) : l; any = true;
+	}
+	CollSplit sp;
+	sp.left = makeNode(b, s, mid, axis, true, lv);
+	sp.right = makeNode(b, mid, e, axis, false, rv);
+	b.splits[idx] = sp;
+	return idx;
+}
+
+static CollNode
+makeNode(Builder &b, int32 s, int32 e, int axis, bool left, float32 value)
+{
+	CollNode n;
+	n.type = axis*4 | (left ? 1 : 0);
+	n.value = value;
+	if(e - s <= b.maxLeaf){
+		n.contents = e - s;
+		n.index = s;
+	}else{
+		n.contents = CollisionTree::SPLIT;
+		n.index = splitRange(b, s, e);
+	}
+	return n;
+}
+
+void
+collisionBuildParamInitDefaults(CollisionBuildParams *p)
+{
+	p->maxEntriesPerLeaf = 2;
+}
+
+CollisionTree*
+CollisionTree::build(const V3d *vertices, const Triangle *tris, int32 n, int32 maxLeaf)
+{
+	if(n < 0 || n > 65536 || maxLeaf < 1 || maxLeaf > 254){
+		RWERROR((ERR_GENERAL, "invalid collision build parameters"));
+		return nil;
+	}
+	if(n == 0)
+		return allocTree(0, 0, true);
+	Builder b;
+	b.v = vertices; b.t = tris; b.maxLeaf = maxLeaf;
+	b.order.resize(n); b.lo.resize(3*n); b.hi.resize(3*n); b.cen.resize(3*n);
+	for(int a = 0; a < 3; a++){ b.binf[a] = 1e30f; b.bsup[a] = -1e30f; }
+	for(int32 i = 0; i < n; i++){
+		b.order[i] = i;
+		for(int a = 0; a < 3; a++){
+			float32 c[3];
+			for(int k = 0; k < 3; k++)
+				c[k] = (&vertices[tris[i].v[k]].x)[a];
+			float32 l = std::min(c[0], std::min(c[1], c[2]));
+			float32 h = std::max(c[0], std::max(c[1], c[2]));
+			b.lo[3*i+a] = l; b.hi[3*i+a] = h;
+			b.cen[3*i+a] = (l+h)*0.5f;
+			b.binf[a] = std::min(b.binf[a], l); b.bsup[a] = std::max(b.bsup[a], h);
+		}
+	}
+	splitRange(b, 0, n);	// the root is always a pair
+	CollisionTree *t = allocTree(n, b.splits.size(), true);
+	if(t == nil)
+		return nil;
+	t->bbox.inf.set(b.binf[0], b.binf[1], b.binf[2]);
+	t->bbox.sup.set(b.bsup[0], b.bsup[1], b.bsup[2]);
+	memcpy(t->splits, &b.splits[0], sizeof(CollSplit)*b.splits.size());
+	memcpy(t->map, &b.order[0], 2*n);
+	return t;
+}
+
+//
+// Primitive tests (double precision internally)
+//
+
+typedef double D3[3];
+
+static void
+toD(D3 d, const V3d &v) { d[0] = v.x; d[1] = v.y; d[2] = v.z; }
+static void dsub(D3 o, const D3 a, const D3 b) { for(int i = 0; i < 3; i++) o[i] = a[i]-b[i]; }
+static double ddot(const D3 a, const D3 b) { return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]; }
+static void dcross(D3 o, const D3 a, const D3 b)
+{
+	o[0] = a[1]*b[2]-a[2]*b[1]; o[1] = a[2]*b[0]-a[0]*b[2]; o[2] = a[0]*b[1]-a[1]*b[0];
+}
+
+bool
+intersectionLineTriangle(const V3d *ls, const V3d *ld, const V3d *v0, const V3d *v1, const V3d *v2, float32 *distance)
+{
+	D3 o, d, a, e1, e2, p, q, s, n;
+	toD(o, *ls); toD(d, *ld); toD(a, *v0);
+	D3 b1, b2; toD(b1, *v1); toD(b2, *v2);
+	dsub(e1, b1, a); dsub(e2, b2, a);
+	dcross(n, e1, e2);
+	if(ddot(n, n) == 0.0)
+		return false;
+	// Moeller-Trumbore with the segment parameter t in [0,1]
+	dcross(p, d, e2);
+	double det = ddot(e1, p);
+	if(det == 0.0)
+		return false;
+	double inv = 1.0/det;
+	dsub(s, o, a);
+	double u = ddot(s, p)*inv;
+	if(u < 0.0 || u > 1.0)
+		return false;
+	dcross(q, s, e1);
+	double v = ddot(d, q)*inv;
+	if(v < 0.0 || u + v > 1.0)
+		return false;
+	double t = ddot(e2, q)*inv;
+	if(t < 0.0 || t > 1.0)
+		return false;
+	if(distance)
+		*distance = (float32)t;
+	return true;
+}
+
+bool
+lineSphereIntersectionTest(const Line *line, const Sphere *sph, float32 *distance)
+{
+	D3 s, e, c, d, m;
+	toD(s, line->start); toD(e, line->end); toD(c, sph->center);
+	dsub(d, e, s); dsub(m, s, c);
+	double r = sph->radius;
+	double cc = ddot(m, m) - r*r;
+	if(cc <= 0.0){	// start inside
+		if(distance) *distance = 0.0f;
+		return true;
+	}
+	double a = ddot(d, d), bb = ddot(m, d);
+	if(a == 0.0)
+		return false;
+	double disc = bb*bb - a*cc;
+	if(disc < 0.0)
+		return false;
+	double t = (-bb - sqrt(disc))/a;	// entry (start is outside, so the smaller root)
+	if(t < 0.0 || t > 1.0)
+		return false;
+	if(distance) *distance = (float32)t;
+	return true;
+}
+
+bool
+baryGetTransform(Matrix *m, float32 *determinant, const V3d *v0, const V3d *v1, const V3d *v2)
+{
+	D3 p0, a, b, e1, e2, n;
+	toD(p0, *v0); toD(a, *v1); toD(b, *v2);
+	dsub(e1, a, p0); dsub(e2, b, p0);
+	dcross(n, e1, e2);
+	double det = ddot(n, n);	// det[e1; e2; n] = n . (e1 x e2)... = |n|^2
+	if(det == 0.0)
+		return false;
+	// rows of R: e1, e2, n. inverse rows = cofactors / det (R^-1 = adj/det)
+	double inv[3][3];
+	// inverse columns: c0 = e2 x n / det, c1 = n x e1 / det, c2 = e1 x e2 / det  (R * inv = I)
+	D3 c0, c1, c2;
+	dcross(c0, e2, n); dcross(c1, n, e1); dcross(c2, e1, e2);
+	for(int i = 0; i < 3; i++){
+		inv[i][0] = c0[i]/det; inv[i][1] = c1[i]/det; inv[i][2] = c2[i]/det;
+	}
+	// q*transform: (u,v,w) = (q - p0) * inv
+	m->right.set(inv[0][0], inv[0][1], inv[0][2]);
+	m->up.set(inv[1][0], inv[1][1], inv[1][2]);
+	m->at.set(inv[2][0], inv[2][1], inv[2][2]);
+	m->pos.set(-(p0[0]*inv[0][0]+p0[1]*inv[1][0]+p0[2]*inv[2][0]),
+	           -(p0[0]*inv[0][1]+p0[1]*inv[1][1]+p0[2]*inv[2][1]),
+	           -(p0[0]*inv[0][2]+p0[1]*inv[1][2]+p0[2]*inv[2][2]));
+	m->flags = Matrix::TYPENORMAL;
+	if(determinant)
+		*determinant = (float32)det;
+	return true;
+}
+
+// closest point of triangle abc to p
+static void
+closestPtTriangle(D3 out, const D3 p, const D3 a, const D3 b, const D3 c)
+{
+	D3 ab, ac, ap, bp, cp;
+	dsub(ab, b, a); dsub(ac, c, a); dsub(ap, p, a);
+	double d1 = ddot(ab, ap), d2 = ddot(ac, ap);
+	if(d1 <= 0 && d2 <= 0){ memcpy(out, a, sizeof(D3)); return; }
+	dsub(bp, p, b);
+	double d3 = ddot(ab, bp), d4 = ddot(ac, bp);
+	if(d3 >= 0 && d4 <= d3){ memcpy(out, b, sizeof(D3)); return; }
+	double vc = d1*d4 - d3*d2;
+	if(vc <= 0 && d1 >= 0 && d3 <= 0){
+		double v = d1/(d1-d3);
+		for(int i = 0; i < 3; i++) out[i] = a[i] + v*ab[i];
+		return;
+	}
+	dsub(cp, p, c);
+	double d5 = ddot(ab, cp), d6 = ddot(ac, cp);
+	if(d6 >= 0 && d5 <= d6){ memcpy(out, c, sizeof(D3)); return; }
+	double vb = d5*d2 - d1*d6;
+	if(vb <= 0 && d2 >= 0 && d6 <= 0){
+		double w = d2/(d2-d6);
+		for(int i = 0; i < 3; i++) out[i] = a[i] + w*ac[i];
+		return;
+	}
+	double va = d3*d6 - d5*d4;
+	if(va <= 0 && (d4-d3) >= 0 && (d5-d6) >= 0){
+		double w = (d4-d3)/((d4-d3)+(d5-d6));
+		for(int i = 0; i < 3; i++) out[i] = b[i] + w*(c[i]-b[i]);
+		return;
+	}
+	double denom = 1.0/(va+vb+vc);
+	double v = vb*denom, w = vc*denom;
+	for(int i = 0; i < 3; i++) out[i] = a[i] + ab[i]*v + ac[i]*w;
+}
+
+// triangle vs axis aligned box (SAT, touching counts)
+static bool
+triBoxOverlap(const D3 center, const D3 half, const D3 va, const D3 vb, const D3 vc)
+{
+	D3 v[3], e[3];
+	dsub(v[0], va, center); dsub(v[1], vb, center); dsub(v[2], vc, center);
+	dsub(e[0], v[1], v[0]); dsub(e[1], v[2], v[1]); dsub(e[2], v[0], v[2]);
+	for(int a = 0; a < 3; a++){	// box axes
+		double mn = std::min(v[0][a], std::min(v[1][a], v[2][a]));
+		double mx = std::max(v[0][a], std::max(v[1][a], v[2][a]));
+		if(mn > half[a] || mx < -half[a])
+			return false;
+	}
+	for(int i = 0; i < 3; i++)
+		for(int a = 0; a < 3; a++){	// axis = box axis a x edge i
+			D3 ax = { 0, 0, 0 }, cr;
+			ax[a] = 1;
+			dcross(cr, ax, e[i]);
+			double p0 = ddot(cr, v[0]), p1 = ddot(cr, v[1]), p2 = ddot(cr, v[2]);
+			double r = half[0]*fabs(cr[0]) + half[1]*fabs(cr[1]) + half[2]*fabs(cr[2]);
+			if(std::min(p0, std::min(p1, p2)) > r || std::max(p0, std::max(p1, p2)) < -r)
+				return false;
+		}
+	D3 n;
+	dcross(n, e[0], e[1]);
+	double d = ddot(n, v[0]);
+	double r = half[0]*fabs(n[0]) + half[1]*fabs(n[1]) + half[2]*fabs(n[2]);
+	return fabs(d) <= r;
+}
+
+//
+// Query
+//
+
+struct Query
+{
+	int32 type;
+	V3d ls, ld;	// line start, delta
+	Sphere sph;
+	BBox box;
+
+	explicit Query(const Intersection *i) {
+		type = i->type;
+		if(type == INTERSECTLINE){ ls = i->t.line.start; ld = sub(i->t.line.end, i->t.line.start); }
+		else if(type == INTERSECTSPHERE) sph = i->t.sphere;
+		else if(type == INTERSECTBOX) box = i->t.box;
+	}
+	// conservative: may report true for a non overlapping region, never false for an overlapping one
+	bool overlaps(const float32 *lo, const float32 *hi) const;
+	// exact triangle test; point/distance see rwcollision.h
+	bool testTriangle(const V3d *a, const V3d *b, const V3d *c, float32 *dist, V3d *pt) const;
+};
+
+static inline double
+slack(double a, double b) { return 1e-5*(1.0 + fabs(a) + fabs(b)); }
+
+bool
+Query::overlaps(const float32 *lo, const float32 *hi) const
+{
+	switch(type){
+	case INTERSECTLINE: {
+		const float32 *s = &ls.x, *d = &ld.x;
+		double t0 = 0.0, t1 = 1.0;
+		for(int a = 0; a < 3; a++){
+			double l = (double)lo[a] - slack(lo[a], s[a]), h = (double)hi[a] + slack(hi[a], s[a]);
+			if(d[a] == 0.0f){
+				if(s[a] < l || s[a] > h)
+					return false;
+			}else{
+				double ta = (l - s[a])/d[a], tb = (h - s[a])/d[a];
+				if(ta > tb) std::swap(ta, tb);
+				t0 = std::max(t0, ta); t1 = std::min(t1, tb);
+				if(t0 > t1)
+					return false;
+			}
+		}
+		return true;
+	}
+	case INTERSECTSPHERE: {
+		const float32 *c = &sph.center.x;
+		double d2 = 0.0;
+		for(int a = 0; a < 3; a++){
+			double l = (double)lo[a] - slack(lo[a], c[a]), h = (double)hi[a] + slack(hi[a], c[a]);
+			double d = c[a] < l ? l - c[a] : (c[a] > h ? c[a] - h : 0.0);
+			d2 += d*d;
+		}
+		double r = (double)sph.radius + slack(sph.radius, 0);
+		return d2 <= r*r;
+	}
+	case INTERSECTBOX: {
+		const float32 *bl = &box.inf.x, *bh = &box.sup.x;
+		for(int a = 0; a < 3; a++)
+			if(bh[a] < (double)lo[a] - slack(lo[a], bh[a]) || bl[a] > (double)hi[a] + slack(hi[a], bl[a]))
+				return false;
+		return true;
+	}
+	}
+	return false;
+}
+
+bool
+Query::testTriangle(const V3d *a, const V3d *b, const V3d *c, float32 *dist, V3d *pt) const
+{
+	D3 A, B, C, n, e1, e2;
+	toD(A, *a); toD(B, *b); toD(C, *c);
+	dsub(e1, B, A); dsub(e2, C, A); dcross(n, e1, e2);
+	if(ddot(n, n) == 0.0)
+		return false;
+	if(type == INTERSECTLINE){
+		float32 t;
+		if(!intersectionLineTriangle(&ls, &ld, a, b, c, &t))
+			return false;
+		*dist = t;
+		pt->set(ls.x + t*ld.x, ls.y + t*ld.y, ls.z + t*ld.z);
+		return true;
+	}
+	D3 ctr, cp, d;
+	if(type == INTERSECTSPHERE){
+		toD(ctr, sph.center);
+		closestPtTriangle(cp, ctr, A, B, C);
+		dsub(d, cp, ctr);
+		double r = sph.radius;
+		if(ddot(d, d) > r*r)
+			return false;
+	}else if(type == INTERSECTBOX){
+		D3 half;
+		toD(ctr, box.inf);
+		D3 sup; toD(sup, box.sup);
+		for(int i = 0; i < 3; i++){ half[i] = (sup[i]-ctr[i])*0.5; ctr[i] = (sup[i]+ctr[i])*0.5; }
+		if(!triBoxOverlap(ctr, half, A, B, C))
+			return false;
+		closestPtTriangle(cp, ctr, A, B, C);
+		dsub(d, cp, ctr);
+	}else
+		return false;
+	*dist = (float32)sqrt(ddot(d, d));
+	pt->set(cp[0], cp[1], cp[2]);
+	return true;
+}
+
+// callback plumbing
+struct Visit
+{
+	const Query *q;
+	Intersection *isec;
+	const V3d *verts;
+	const Triangle *tris;
+	WorldSector *sector;
+	WorldIntersectionCB wcb;
+	GeometryIntersectionCB gcb;
+	void *data;
+};
+
+// false = stop
+static bool
+visitTriangle(Visit *vis, uint32 index)
+{
+	const Triangle *t = &vis->tris[index];
+	V3d *v0 = (V3d*)&vis->verts[t->v[0]], *v1 = (V3d*)&vis->verts[t->v[1]], *v2 = (V3d*)&vis->verts[t->v[2]];
+	float32 dist;
+	CollisionTriangle ct;
+	if(!vis->q->testTriangle(v0, v1, v2, &dist, &ct.point))
+		return true;
+	D3 A, B, C, e1, e2, n;
+	toD(A, *v0); toD(B, *v1); toD(C, *v2);
+	dsub(e1, B, A); dsub(e2, C, A); dcross(n, e1, e2);
+	double l = sqrt(ddot(n, n));	// nonzero, degenerate triangles were rejected
+	ct.normal.set(n[0]/l, n[1]/l, n[2]/l);
+	ct.index = index;
+	ct.vertices[0] = v0; ct.vertices[1] = v1; ct.vertices[2] = v2;
+	CollisionTriangle *r = vis->sector ?
+		vis->wcb(vis->isec, vis->sector, &ct, dist, vis->data) :
+		vis->gcb(vis->isec, &ct, dist, vis->data);
+	return r != nil;
+}
+
+static bool
+walkNode(const CollisionTree *tree, const CollNode &n, const float32 *lo, const float32 *hi, Visit *vis)
+{
+	float32 nlo[3] = { lo[0], lo[1], lo[2] }, nhi[3] = { hi[0], hi[1], hi[2] };
+	int a = (n.type >> 2) & 3;
+	if(n.type & 1) nhi[a] = std::min(nhi[a], n.value);
+	else nlo[a] = std::max(nlo[a], n.value);
+	if(!vis->q->overlaps(nlo, nhi))
+		return true;
+	if(n.contents == CollisionTree::SPLIT){
+		const CollSplit &s = tree->splits[n.index];
+		return walkNode(tree, s.left, nlo, nhi, vis) && walkNode(tree, s.right, nlo, nhi, vis);
+	}
+	for(uint32 k = n.index; k < (uint32)n.index + n.contents; k++)
+		if(!visitTriangle(vis, tree->entry(k)))
+			return false;
+	return true;
+}
+
+// false = stopped by the callback
+static bool
+queryTree(const CollisionTree *tree, int32 numTris, Visit *vis)
+{
+	if(tree == nil || tree->numSplits == 0){
+		if(tree == nil)	// no tree: every triangle
+			for(int32 i = 0; i < numTris; i++)
+				if(!visitTriangle(vis, i))
+					return false;
+		return true;
+	}
+	const float32 inf = INFINITY;
+	const float32 lo[3] = { -inf, -inf, -inf }, hi[3] = { inf, inf, inf };
+	const CollSplit &root = tree->splits[0];
+	return walkNode(tree, root.left, lo, hi, vis) && walkNode(tree, root.right, lo, hi, vis);
+}
+
+static bool
+supported(const Intersection *i)
+{
+	return i && (i->type == INTERSECTLINE || i->type == INTERSECTSPHERE || i->type == INTERSECTBOX);
+}
+
+World*
+collisionWorldForAllIntersections(World *world, Intersection *isec, WorldIntersectionCB cb, void *data)
+{
+	if(world == nil || cb == nil || !supported(isec)){
+		RWERROR((ERR_GENERAL, "unsupported intersection"));
+		return nil;
+	}
+	Query q(isec);
+	for(int32 i = 0; i < world->numSectors; i++){
+		WorldSector *s = world->sectors[i];
+		if(s->numTriangles == 0 || s->numVertices == 0)
+			continue;
+		if(!q.overlaps(&s->bbox.inf.x, &s->bbox.sup.x))
+			continue;
+		Visit vis = { &q, isec, s->vertices, s->triangles, s, cb, nil, data };
+		if(!queryTree(s->collTree, s->numTriangles, &vis))
+			break;
+	}
+	return world;
+}
+
+CollisionTree*
+collisionWorldSectorQueryData(WorldSector *s)
+{
+	return s->collTree;
+}
+
+void
+collisionWorldSectorDestroyData(WorldSector *s)
+{
+	if(s->collTree){
+		s->collTree->destroy();
+		s->collTree = nil;
+	}
+}
+
+//
+// Geometry plugin
+//
+
+static int32 collisionOffset;
+struct CollisionGeo { CollisionTree *tree; };
+#define COLLGEO(g) PLUGINOFFSET(CollisionGeo, g, collisionOffset)
+
+static void*
+createCollGeo(void *object, int32 offset, int32)
+{
+	COLLGEO(object)->tree = nil;
+	return object;
+}
+
+static void*
+destroyCollGeo(void *object, int32, int32)
+{
+	CollisionGeo *c = COLLGEO(object);
+	if(c->tree)
+		c->tree->destroy();
+	c->tree = nil;
+	return object;
+}
+
+static void*
+copyCollGeo(void *dst, void *src, int32, int32)
+{
+	CollisionGeo *s = COLLGEO(src), *d = COLLGEO(dst);
+	d->tree = s->tree ? s->tree->clone() : nil;
+	return dst;
+}
+
+static Stream*
+readCollGeo(Stream *stream, int32 length, void *object, int32, int32)
+{
+	Geometry *geo = (Geometry*)object;
+	uint8 *buf = rwNewT(uint8, length, MEMDUR_EVENT | ID_COLLISION);
+	if(buf == nil)
+		return nil;
+	stream->read8(buf, length);
+	CollisionTree *t = CollisionTree::fromBlob(buf, length, geo->numTriangles);
+	rwFree(buf);
+	if(t == nil)
+		return nil;
+	CollisionGeo *c = COLLGEO(object);
+	if(c->tree)
+		c->tree->destroy();
+	c->tree = t;
+	return stream;
+}
+
+static Stream*
+writeCollGeo(Stream *stream, int32 length, void *object, int32, int32)
+{
+	CollisionGeo *c = COLLGEO(object);
+	uint8 *buf = rwNewT(uint8, length, MEMDUR_EVENT | ID_COLLISION);
+	if(buf == nil)
+		return nil;
+	c->tree->toBlob(buf);
+	stream->write8(buf, length);
+	rwFree(buf);
+	return stream;
+}
+
+static int32
+getSizeCollGeo(void *object, int32, int32)
+{
+	CollisionGeo *c = COLLGEO(object);
+	return c->tree ? c->tree->blobSize() : 0;
+}
+
+void
+registerCollisionPlugin(void)
+{
+	collisionOffset = Geometry::registerPlugin(sizeof(CollisionGeo), ID_COLLISION,
+		createCollGeo, destroyCollGeo, copyCollGeo);
+	Geometry::registerPluginStream(ID_COLLISION, readCollGeo, writeCollGeo, getSizeCollGeo);
+}
+
+CollisionTree*
+collisionGeometryQueryData(Geometry *geo)
+{
+	return COLLGEO(geo)->tree;
+}
+
+void
+collisionGeometryDestroyData(Geometry *geo)
+{
+	CollisionGeo *c = COLLGEO(geo);
+	if(c->tree)
+		c->tree->destroy();
+	c->tree = nil;
+}
+
+bool
+collisionGeometryBuildData(Geometry *geo, const CollisionBuildParams *params)
+{
+	CollisionBuildParams def;
+	if(params == nil){
+		collisionBuildParamInitDefaults(&def);
+		params = &def;
+	}
+	if(geo->numMorphTargets < 1 || geo->morphTargets[0].vertices == nil){
+		RWERROR((ERR_GENERAL, "geometry has no vertices"));
+		return false;
+	}
+	for(int32 i = 0; i < geo->numTriangles; i++)
+		for(int k = 0; k < 3; k++)
+			if(geo->triangles[i].v[k] >= geo->numVertices){
+				RWERROR((ERR_GENERAL, "triangle index out of range"));
+				return false;
+			}
+	CollisionTree *t = CollisionTree::build(geo->morphTargets[0].vertices, geo->triangles,
+		geo->numTriangles, params->maxEntriesPerLeaf);
+	if(t == nil)
+		return false;
+	collisionGeometryDestroyData(geo);
+	COLLGEO(geo)->tree = t;
+	return true;
+}
+
+Geometry*
+collisionGeometryForAllIntersections(Geometry *geo, Intersection *isec, GeometryIntersectionCB cb, void *data)
+{
+	if(geo == nil || cb == nil || !supported(isec) || geo->numMorphTargets < 1){
+		RWERROR((ERR_GENERAL, "unsupported intersection"));
+		return nil;
+	}
+	Query q(isec);
+	Visit vis = { &q, isec, geo->morphTargets[0].vertices, geo->triangles, nil, nil, cb, data };
+	queryTree(COLLGEO(geo)->tree, geo->numTriangles, &vis);
+	return geo;
+}
+
+Atomic*
+collisionAtomicForAllIntersections(Atomic *atomic, Intersection *isec, GeometryIntersectionCB cb, void *data)
+{
+	if(atomic == nil || atomic->geometry == nil || !supported(isec))
+		return nil;
+	Intersection loc = *isec;
+	Frame *f = atomic->getFrame();
+	if(f){
+		Matrix inv;
+		Matrix::invertGeneral(&inv, f->getLTM());	// not invert(): stale orthonormal flags after a scale would pick the wrong path
+		V3d p[8];
+		switch(isec->type){
+		case INTERSECTLINE:
+			p[0] = isec->t.line.start; p[1] = isec->t.line.end;
+			V3d::transformPoints(p, p, 2, &inv);
+			loc.t.line.start = p[0]; loc.t.line.end = p[1];
+			break;
+		case INTERSECTSPHERE: {
+			V3d c = isec->t.sphere.center;
+			V3d::transformPoints(&c, &c, 1, &inv);
+			loc.t.sphere.center = c;
+			loc.t.sphere.radius = isec->t.sphere.radius*length(inv.right);	// uniform scale assumed
+			break; }
+		case INTERSECTBOX: {
+			const BBox &b = isec->t.box;
+			for(int i = 0; i < 8; i++)
+				p[i].set(i&1 ? b.sup.x : b.inf.x, i&2 ? b.sup.y : b.inf.y, i&4 ? b.sup.z : b.inf.z);
+			V3d::transformPoints(p, p, 8, &inv);
+			loc.t.box.inf = loc.t.box.sup = p[0];
+			for(int i = 1; i < 8; i++)
+				loc.t.box.addPoint(&p[i]);
+			break; }
+		}
+	}
+	collisionGeometryForAllIntersections(atomic->geometry, &loc, cb, data);
+	return atomic;
+}
+
