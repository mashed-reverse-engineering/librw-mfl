From 18532c2e13efbc1aa43f0b00b4459831f9414de0 Mon Sep 17 00:00:00 2001
From: SciLor <scilor@users.noreply.github.com>
Date: Mon, 19 Oct 2026 12:00:00 +0000
Subject: [PATCH] render: add FILLMODE render state (D3D9 only)

Author: redcodepro (sr-tream/librw 5d25509). Imgui skeleton hunk omitted. MIT.

Upstream-ref: https://github.com/sr-tream/librw/commit/5d25509
---
 src/d3d/d3ddevice.cpp | 19 +++++++++++++++++++
 src/rwrender.h        |  8 ++++++++
 2 files changed, 27 insertions(+)

diff --git a/src/d3d/d3ddevice.cpp b/src/d3d/d3ddevice.cpp
index 62c46b8..de36db3 100644
--- a/src/d3d/d3ddevice.cpp
+++ b/src/d3d/d3ddevice.cpp
@@ -78,6 +78,7 @@ struct RwStateCache {
 	uint32 fogenable;
 	RGBA fogcolor;
 	uint32 cullmode;
+	uint32 fillmode;
 	uint32 stencilenable;
 	uint32 stencilpass;
 	uint32 stencilfail;
@@ -204,6 +205,12 @@ static uint32 cullmodeMap[] = {
 	D3DCULL_CCW
 };
 
+static uint32 fillmodeMap[] = {
+	D3DFILL_POINT,
+	D3DFILL_WIREFRAME,
+	D3DFILL_SOLID,
+};
+
 static uint32 filterConvMap[] = {
 	0, D3DTEXF_POINT, D3DTEXF_LINEAR,
 	   D3DTEXF_POINT, D3DTEXF_LINEAR,
@@ -681,6 +688,12 @@ setRwRenderState(int32 state, void *pvalue)
 			setRenderState(D3DRS_CULLMODE, cullmodeMap[value]);
 		}
 		break;
+	case FILLMODE:
+		if(rwStateCache.fillmode != value){
+			rwStateCache.fillmode = value;
+			setRenderState(D3DRS_FILLMODE, fillmodeMap[value]);
+		}
+		break;
 
 	case STENCILENABLE:
 		if(rwStateCache.stencilenable != bval){
@@ -800,6 +813,9 @@ getRwRenderState(int32 state)
 	case CULLMODE:
 		val = rwStateCache.cullmode;
 		break;
+	case FILLMODE:
+		val = rwStateCache.fillmode;
+		break;
 
 	case STENCILENABLE:
 		val = rwStateCache.stencilenable;
@@ -1685,6 +1701,9 @@ initD3D(void)
 	d3ddevice->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
 	rwStateCache.cullmode = CULLNONE;
 
+	d3ddevice->SetRenderState(D3DRS_FILLMODE, D3DFILL_SOLID);
+	rwStateCache.fillmode = FILLSOLID;
+
 	d3ddevice->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD);
 	d3ddevice->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
 	rwStateCache.srcblend = BLENDSRCALPHA;
diff --git a/src/rwrender.h b/src/rwrender.h
index 49fe0c4..002334d 100644
--- a/src/rwrender.h
+++ b/src/rwrender.h
@@ -17,6 +17,7 @@ enum RenderState
 	FOGENABLE,
 	FOGCOLOR,
 	CULLMODE,
+	FILLMODE, // d3d9 only !!!
 	// TODO:
 	// fog type, density ?
 	// ? shademode
@@ -94,6 +95,13 @@ enum BlendFunction
 	// TODO: add more perhaps
 };
 
+enum FillMode
+{
+	FILLPOINT,
+	FILLWIREFRAME,
+	FILLSOLID
+};
+
 void SetRenderState(int32 state, uint32 value);
 void SetRenderStatePtr(int32 state, void *value);
 uint32 GetRenderState(int32 state);
-- 
