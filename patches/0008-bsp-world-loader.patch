+		for(int32 i = 0; i < 8; i++)
+			rwFree(s->texCoords[i]);
+		rwFree(s->triangles);
+		rwFree(s->collision);
+	}else{
+		PlaneSector *p = (PlaneSector*)n;
+		destroyNode(p->left);
+		destroyNode(p->right);
+	}
+	rwFree(n);
+}
