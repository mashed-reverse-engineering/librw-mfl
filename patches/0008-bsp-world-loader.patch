+static void
+destroyNode(BspNode *n)
+{
+	if(n == nil)
+		return;
+	if(n->isLeaf){
+		WorldSector *s = (WorldSector*)n;
+		if(s->atomic){
+			Frame *f = s->atomic->getFrame();
+			s->atomic->destroy();	// also drops the geometry
+			if(f)
