+// RpPTank subset for Mashed: atomic extension holding the particle arrays, Lock/Unlock with the game's stride semantics,
+// CPU billboard instancing and an Im3D render path (backend independent: D3D9 / GL3 / anything with Im3D).
+// Decompilation-informed (the game's statically linked PTank code: create 0x545170/0x545310/0x545940, lock 0x545d10,
+// unlock 0x545f20, instancing 0x545f60 .. 0x548910); no SDK source or headers were copied. Guesses are marked "GUESS",
+// deviations from the original "DEVIATION"; all collected in MFL_NOTES.md.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <stddef.h>
+
+#include "rwbase.h"
+#include "rwerror.h"
+#include "rwplg.h"
+#include "rwpipeline.h"
+#include "rwobjects.h"
+#include "rwengine.h"
+#include "rwrender.h"
+#include "rwptank.h"
+
+#include "ps2/rwps2.h"
+#include "d3d/rwd3d.h"
+#include "gl/rwgl3.h"
+
+#define PLUGIN_ID ID_PTANK
+
+namespace rw {
+namespace ptank {
+
+int32 atomicDataOffset = -1;
+
+// layout of the original structure (32 bit builds only; on 64 bit the pointer members shift the later offsets)
+#define OFF(f, v) static_assert(sizeof(void*) != 4 || offsetof(Data, f) == (v), "PTank Data layout: " #f)
+OFF(activeCount, 0x04); OFF(block, 0x0c); OFF(origRenderCB, 0x10); OFF(callbacks, 0x14); OFF(lockedFlags, 0x3c);
+OFF(updateFlags, 0x40); OFF(platformFlags, 0x44); OFF(arrays, 0x4c); OFF(numArrays, 0x98); OFF(totalStride, 0x9c);
+OFF(formatFlags, 0xa0); OFF(srcBlend, 0xa4); OFF(dstBlend, 0xa8); OFF(blendEnable, 0xac); OFF(cnsCenter, 0xb0);
+OFF(cnsSize, 0xb8); OFF(cnsRotate, 0xc0); OFF(cnsColor, 0xc4); OFF(cnsVtxColor, 0xc8); OFF(cnsTexCoords, 0xd8);
+OFF(cnsMatrix, 0xf8);
+static_assert(sizeof(void*) != 4 || sizeof(Data) == 0x138, "PTank Data size");
+
+static QuadSink userSink;
+static void *userSinkData;
+
+void setQuadSink(QuadSink s, void *user) { userSink = s; userSinkData = user; }
+
+// array order (index into Data::arrays), bit and element size
+static const uint32 arrBit[NUMARRAYS]  = { DPOSITION, DMATRIX, DNORMALS, DSIZE, DCOLOR, DVTXCOLOR, DROTATE2D, DVTX2TEXCOORDS, DVTX4TEXCOORDS };
+static const int32  arrSize[NUMARRAYS] = { 12, 64, 12, 8, 4, 16, 4, 16, 32 };
+
+static int
+arrIndex(uint32 bit)
+{
+	for(int i = 0; i < NUMARRAYS; i++)
+		if(arrBit[i] == bit)
+			return i;
+	return -1;
+}
+
+uint32
+normalizeFlags(uint32 f)
+{
+	// Reproduces the compiled behaviour of the original, including the lines that look like bugs:
+	// "constant AND array requested" masks the whole word down to the constant bit (instead of just dropping the array).
+	bool pos = (f & DPOSITION) != 0, size = (f & DSIZE) != 0, mat = (f & DMATRIX) != 0, rot = (f & DROTATE2D) != 0;
+	bool vc = (f & DVTXCOLOR) != 0, t2 = (f & DVTX2TEXCOORDS) != 0, t4 = (f & DVTX4TEXCOORDS) != 0;
+	if(mat && (f & DCNSMATRIX)) f &= DCNSMATRIX;
+	if(rot && (f & DCNSROTATE2D)) f &= DCNSROTATE2D;
+	if(vc && (f & DCNSVTXCOLOR)) f &= DCNSVTXCOLOR;
+	if(t2 && (f & DCNSVTX2TEXCOORDS)) f &= DCNSVTX2TEXCOORDS;
+	if(t4 && (f & DCNSVTX4TEXCOORDS)) f &= DCNSVTX4TEXCOORDS;
+	if(mat){	// per particle matrix replaces position, size and 2D rotation
+		if(pos) f &= ~DPOSITION;
+		if(size) f &= ~DSIZE;
+		if(rot) f &= ~DROTATE2D;
+	}
+	if(!mat && !pos)
+		f |= DPOSITION;
+	if((f & DLAYOUTMASK) == 0)
+		f |= DLAYOUT_ARRAYS;
+	return f;
+}
+
+// ---- plugin
+static void*
+ptankCtor(void *object, int32 offset, int32)
+{
+	*PLUGINOFFSET(Data*, object, offset) = nil;
+	return object;
+}
+
+static void*
+ptankDtor(void *object, int32 offset, int32)
+{
+	Atomic *a = (Atomic*)object;
+	Data *d = *PLUGINOFFSET(Data*, object, offset);
+	if(d){
+		// the original drops the texture of material 0 here; Atomic::destroy would do it through the geometry anyway
+		if(a->geometry && a->geometry->matList.numMaterials > 0 && a->geometry->matList.materials[0])
+			a->geometry->matList.materials[0]->setTexture(nil);
+		if(d->block)
+			rwFree(d->block);
+		rwFree(d);
+		*PLUGINOFFSET(Data*, object, offset) = nil;
+	}
+	return object;
+}
+
+static void*
+ptankCopy(void *dst, void *, int32 offset, int32)
+{
+	// the original registers no copy constructor: a cloned atomic has no tank (render callback must cope)
+	*PLUGINOFFSET(Data*, dst, offset) = nil;
+	return dst;
+}
+
+int32
+registerPlugin(void)
+{
+	atomicDataOffset = Atomic::registerPlugin(sizeof(Data*), PLUGIN_ID, ptankCtor, ptankDtor, ptankCopy);
+	return atomicDataOffset;
+}
+
+// ---- create
+static bool
+allocArrays(Data *d, uint32 flags)
+{
+	int64 n = d->maxCount;
+	bool interleaved = (flags & DLAYOUT_INTERLEAVED) != 0;
+	int32 stride = 0;
+	d->numArrays = 0;
+	d->formatFlags = 0;
+	for(int i = 0; i < NUMARRAYS; i++)
+		if(flags & arrBit[i]){
+			d->numArrays++;
+			d->formatFlags |= arrBit[i];
+			stride += arrSize[i];
+		}
+	// the constant bits and layout bits of the request stay in the format word (the original keeps only array bits here and
+	// ORs the rest back later is not observable: Lock/render look at array bits and the CNS bits of the normalised word)
+	d->formatFlags |= flags & ~(uint32)(DPOSITION|DCOLOR|DSIZE|DMATRIX|DNORMALS|DROTATE2D|DVTXCOLOR|DVTX2TEXCOORDS|DVTX4TEXCOORDS);
+	int64 bytes = n*stride + 16;
+	if(n < 0 || n > MAXPARTICLES || bytes > (int64)0x7FFFFFF0){
+		RWERROR((ERR_ALLOC, (int32)bytes));
+		return false;
+	}
+	// DEVIATION: the original does not clear the block (rwmalloc); we do, so reads of unwritten arrays are deterministic.
+	uint8 *raw = (uint8*)rwMalloc((size_t)bytes, MEMDUR_EVENT | PLUGIN_ID);
+	if(raw == nil){
+		RWERROR((ERR_ALLOC, (int32)bytes));
+		return false;
+	}
+	memset(raw, 0, (size_t)bytes);
+	d->block = raw;
+	uint8 *base = (uint8*)(((uintptr)raw + 15) & ~(uintptr)15);
+	int32 off = 0;
+	for(int i = 0; i < NUMARRAYS; i++){
+		if(!(flags & arrBit[i]))
+			continue;
+		if(interleaved){
+			d->arrays[i].data = base + off;
+			d->arrays[i].stride = stride;
+			off += arrSize[i];
+		}else{
+			d->arrays[i].data = base + (size_t)(n*off);
+			d->arrays[i].stride = arrSize[i];
+			off += arrSize[i];
+		}
+	}
+	d->totalStride = interleaved ? stride : 0;
+	return true;
+}
+
+static void
+setDefaults(Data *d)
+{
+	d->cnsCenter[0] = d->cnsCenter[1] = 0.0f;
+	d->cnsSize[0] = d->cnsSize[1] = 1.0f;
+	d->cnsRotate = 0.0f;
+	// 0xFF000000 as a little endian dword: r = g = b = 0, a = 255
+	for(int i = 0; i < 4; i++)
+		d->cnsColor[i] = i == 3 ? 0xFF : 0;
+	for(int v = 0; v < 4; v++)
+		for(int i = 0; i < 4; i++)
+			d->cnsVtxColor[v][i] = i == 3 ? 0xFF : 0;
+	// 8 floats 0,0,0,1,1,1,1,0 (u,v pairs (0,0) (0,1) (1,1) (1,0)); also read as {u0,v1,u1,v0} by the 2 coordinate variant
+	static const float32 tc[8] = { 0, 0, 0, 1, 1, 1, 1, 0 };
+	memcpy(d->cnsTexCoords, tc, sizeof(tc));
+	d->cnsMatrix.setIdentity();
+	d->cnsMatrix.flags = 0x20003;	// identity | orthonormal
+}
+
+Atomic*
+atomicCreate(int32 maxCount, uint32 flags, uint32 platformFlags)
+{
+	if(atomicDataOffset < 0){
+		RWERROR((ERR_GENERAL, "PTank plugin not registered"));
+		return nil;
+	}
+	flags = normalizeFlags(flags);
+	Atomic *a = Atomic::create();
+	if(a == nil)
+		return nil;
+	Data *d = (Data*)rwMalloc(sizeof(Data), MEMDUR_EVENT | PLUGIN_ID);
+	if(d == nil){
+		RWERROR((ERR_ALLOC, (int32)sizeof(Data)));
+		a->destroy();
+		return nil;
+	}
+	memset(d, 0, sizeof(*d));
+	d->maxCount = maxCount;
+	d->activeCount = 0;
+	d->lockedFlags = 0;
+	d->updateFlags = 0xFFFFFFFF;	// everything changed
+	d->platformFlags = platformFlags;
+	d->origRenderCB = a->renderCB;
+	a->renderCB = render;
+	*PLUGINOFFSET(Data*, a, atomicDataOffset) = d;	// from here the plugin destructor owns d
+	if(!allocArrays(d, flags)){
+		a->destroy();
+		return nil;
+	}
+	// geometry with one material (the game binds the particle texture to it) and one morph target
+	Geometry *geo = Geometry::create(0, 0, 0);
+	Material *mat = geo ? Material::create() : nil;
+	if(geo == nil || mat == nil){
+		if(geo) geo->destroy();
+		a->destroy();
+		return nil;
+	}
+	mat->surfaceProps.ambient = 0.3f;	// original values (0x3e99999a, 1.0, 1.0)
+	mat->surfaceProps.specular = 1.0f;
+	mat->surfaceProps.diffuse = 1.0f;
+	geo->matList.appendMaterial(mat);
+	mat->destroy();	// the list holds its own reference
+	a->setGeometry(geo, 0);
+	geo->destroy();
+	setDefaults(d);
+	// blend state: the original samples the device state at create time
+	d->srcBlend = d->dstBlend = d->blendEnable = 0;
+	if(engine && engine->device.getRenderState){
+		d->srcBlend = (int32)GetRenderState(SRCBLEND);
+		d->dstBlend = (int32)GetRenderState(DESTBLEND);
+		d->blendEnable = (int32)GetRenderState(VERTEXALPHA);
+	}
+	return a;
+}
+
+// ---- lock / unlock
+bool32
+atomicLock(Atomic *a, LockArray *out, uint32 which, uint32 lockMode)
+{
+	out->data = nil;
+	out->stride = 0;
+	Data *d = a ? getData(a) : nil;
+	if(d == nil)
+		return 0;
+	int idx = arrIndex(which);	// DEVIATION: the original returns 1 with the out struct untouched for non single array bits
+	if(idx < 0 || (d->formatFlags & which) == 0)
+		return 0;
+	out->data = d->arrays[idx].data;
+	out->stride = d->arrays[idx].stride;
+	if(d->totalStride != 0)
+		out->stride = d->totalStride;
+	if(out->data != nil && (lockMode & DLOCKWRITE) == DLOCKWRITE)
+		d->lockedFlags |= which | lockMode;
+	return 1;
+}
+
+void
+atomicUnlock(Atomic *a)
+{
+	Data *d = a ? getData(a) : nil;
+	if(d == nil)
+		return;
+	uint32 l = d->lockedFlags;
+	d->lockedFlags = 0;
+	d->updateFlags |= l;
+}
+
+void
+syncBoundingSphere(Atomic *a)
+{
+	if(a->geometry && a->geometry->numMorphTargets > 0){
+		a->boundingSphere = a->geometry->morphTargets[0].boundingSphere;
+		a->object.object.privateFlags |= Atomic::WORLDBOUNDDIRTY;
+		if(a->getFrame())
+			a->getFrame()->updateObjects();
+	}
+}
+
+// ---- instancing
+static inline float32 rd(const uint8 *p, int i) { float32 f; memcpy(&f, p + 4*i, 4); return f; }
+
+int32
+buildQuads(Atomic *a, const Matrix *cam, int32 first, int32 n, QuadVertex *out)
+{
+	Data *d = a ? getData(a) : nil;
+	if(d == nil || first < 0 || n <= 0)
+		return 0;
+	int32 active = d->activeCount < d->maxCount ? d->activeCount : d->maxCount;	// DEVIATION: the original trusts the count
+	if(first >= active)
+		return 0;
+	if(n > active - first)
+		n = active - first;
+	uint32 f = d->formatFlags;
+	const ArrayDesc *A = d->arrays;
+	enum { P, M, N, S, C, VC, R, T2, T4 };
+
+	// billboard axes (game: R = -camera right, U = camera up; constant matrix replaces both; constant rotation turns them)
+	V3d R_, U_;
+	if(f & DCNSMATRIX){
+		R_ = d->cnsMatrix.right;
+		U_ = d->cnsMatrix.up;
+	}else{
+		R_.set(-cam->right.x, -cam->right.y, -cam->right.z);
+		U_ = cam->up;
+		if(f & DCNSROTATE2D){
+			float32 c = cosf(d->cnsRotate), s = sinf(d->cnsRotate);
+			V3d r2, u2;
+			r2.set(c*R_.x - s*U_.x, c*R_.y - s*U_.y, c*R_.z - s*U_.z);
+			u2.set(s*R_.x + c*U_.x, s*R_.y + c*U_.y, s*R_.z + c*U_.z);
+			R_ = r2; U_ = u2;
+		}
+	}
+	// handler selection as in the original: matrix; else (not CNSMATRIX) rotate/size arrays; else constant size
+	bool matrix = (f & DMATRIX) != 0;
+	bool rotArr = !matrix && !(f & DCNSMATRIX) && (f & DROTATE2D);
+	bool sizeArr = !matrix && !(f & DCNSMATRIX) && (f & DSIZE);
+	bool center = (f & DCENTER) != 0;
+
+	for(int32 i = 0; i < n; i++){
+		int32 k = first + i;
+		QuadVertex *q = out + 4*i;
+		float32 x[4], y[4], z[4];
+		if(matrix){
+			const uint8 *m = A[M].data + (size_t)k*A[M].stride;
+			V3d right, up, pos;
+			right.set(rd(m,0), rd(m,1), rd(m,2));
+			up.set(rd(m,4), rd(m,5), rd(m,6));
+			pos.set(rd(m,12), rd(m,13), rd(m,14));
+			if(center){
+				pos.x += d->cnsCenter[0]*right.x + d->cnsCenter[1]*up.x;
+				pos.y += d->cnsCenter[0]*right.y + d->cnsCenter[1]*up.y;
+				pos.z += d->cnsCenter[0]*right.z + d->cnsCenter[1]*up.z;
+			}
+			float32 hx = (right.x + up.x)*0.5f, hy = (right.y + up.y)*0.5f, hz = (right.z + up.z)*0.5f;
+			float32 dx = (right.x - up.x)*0.5f, dy = (right.y - up.y)*0.5f, dz = (right.z - up.z)*0.5f;
+			x[0] = pos.x + dx; y[0] = pos.y + dy; z[0] = pos.z + dz;
+			x[1] = pos.x - hx; y[1] = pos.y - hy; z[1] = pos.z - hz;
+			x[2] = pos.x - dx; y[2] = pos.y - dy; z[2] = pos.z - dz;
+			x[3] = pos.x + hx; y[3] = pos.y + hy; z[3] = pos.z + hz;
+		}else{
+			const uint8 *p = A[P].data + (size_t)k*A[P].stride;
+			float32 w, h;
+			if(sizeArr){
+				const uint8 *s = A[S].data + (size_t)k*A[S].stride;
+				w = rd(s,0); h = rd(s,1);
+			}else{
+				w = d->cnsSize[0]; h = d->cnsSize[1];
+			}
+			V3d r = R_, u = U_;
+			if(rotArr){
+				float32 ang = rd(A[R].data + (size_t)k*A[R].stride, 0);
+				float32 c = cosf(ang), s = sinf(ang);
+				V3d r2, u2;
+				r2.set(c*R_.x - s*U_.x, c*R_.y - s*U_.y, c*R_.z - s*U_.z);
+				u2.set(c*U_.x + s*R_.x, c*U_.y + s*R_.y, c*U_.z + s*R_.z);
+				r = r2; u = u2;
+			}
+			float32 px = rd(p,0), py = rd(p,1), pz = rd(p,2);
+			if(center){	// GUESS for the rotated/size array variants (only the plain one was read): offset in the (rotated) axes
+				px += d->cnsCenter[0]*r.x + d->cnsCenter[1]*u.x;
+				py += d->cnsCenter[0]*r.y + d->cnsCenter[1]*u.y;
+				pz += d->cnsCenter[0]*r.z + d->cnsCenter[1]*u.z;
+			}
+			float32 ax = r.x*w*0.5f, ay = r.y*w*0.5f, az = r.z*w*0.5f;
+			float32 bx = u.x*h*0.5f, by = u.y*h*0.5f, bz = u.z*h*0.5f;
+			x[0] = px - ax - bx; y[0] = py - ay - by; z[0] = pz - az - bz;
+			x[1] = px + ax - bx; y[1] = py + ay - by; z[1] = pz + az - bz;
+			x[2] = px + ax + bx; y[2] = py + ay + by; z[2] = pz + az + bz;
+			x[3] = px - ax + bx; y[3] = py - ay + by; z[3] = pz - az + bz;
+		}
+		// colour: per particle, per corner, constant per corner, else constant
+		uint8 col[4][4];
+		if(f & DCOLOR){
+			const uint8 *c = A[C].data + (size_t)k*A[C].stride;
+			for(int v = 0; v < 4; v++) memcpy(col[v], c, 4);
+		}else if(f & DVTXCOLOR){
+			const uint8 *c = A[VC].data + (size_t)k*A[VC].stride;
+			memcpy(col, c, 16);
+		}else if(f & DCNSVTXCOLOR){
+			memcpy(col, d->cnsVtxColor, 16);
+		}else{
+			for(int v = 0; v < 4; v++) memcpy(col[v], d->cnsColor, 4);
+		}
+		// texture coordinates
+		float32 tu[4], tv[4];
+		if(f & DVTX2TEXCOORDS){
+			const uint8 *t = A[T2].data + (size_t)k*A[T2].stride;
+			float32 u0 = rd(t,0), v1 = rd(t,1), u1 = rd(t,2), v0 = rd(t,3);	// {uLeft, vTop, uRight, vBottom}
+			tu[0] = u0; tv[0] = v0; tu[1] = u1; tv[1] = v0; tu[2] = u1; tv[2] = v1; tu[3] = u0; tv[3] = v1;
+		}else if(f & DVTX4TEXCOORDS){
+			const uint8 *t = A[T4].data + (size_t)k*A[T4].stride;
+			for(int v = 0; v < 4; v++){ tu[v] = rd(t, 2*v); tv[v] = rd(t, 2*v+1); }
+		}else if(f & DCNSVTX2TEXCOORDS){
+			const float32 *t = d->cnsTexCoords;
+			tu[0] = t[0]; tv[0] = t[3]; tu[1] = t[2]; tv[1] = t[3]; tu[2] = t[2]; tv[2] = t[1]; tu[3] = t[0]; tv[3] = t[1];
+		}else if(f & DCNSVTX4TEXCOORDS){
+			for(int v = 0; v < 4; v++){ tu[v] = d->cnsTexCoords[2*v]; tv[v] = d->cnsTexCoords[2*v+1]; }
+		}else{	// DEVIATION: the original leaves the coordinates unwritten; use the whole texture
+			tu[0] = 0; tv[0] = 1; tu[1] = 1; tv[1] = 1; tu[2] = 1; tv[2] = 0; tu[3] = 0; tv[3] = 0;
+		}
+		float32 nx = 0, ny = 0, nz = 0;
+		if(f & DNORMALS){
+			const uint8 *nn = A[N].data + (size_t)k*A[N].stride;
+			nx = rd(nn,0); ny = rd(nn,1); nz = rd(nn,2);
+		}
+		for(int v = 0; v < 4; v++){
+			QuadVertex *o = &q[v];
+			o->x = x[v]; o->y = y[v]; o->z = z[v];
+			o->nx = nx; o->ny = ny; o->nz = nz;
+			o->r = col[v][0]; o->g = col[v][1]; o->b = col[v][2]; o->a = col[v][3];
+			o->u = tu[v]; o->v = tv[v];
+		}
+	}
+	return n;
+}
+
+// ---- render
+enum { BATCH = 256 };
+
+#ifdef RWDEVICE
+static void
+im3dDraw(Texture *tex, const QuadVertex *q, int32 nq, bool blend)
+{
+	static RWDEVICE::Im3DVertex verts[BATCH*4];
+	static uint16 idx[BATCH*6];
+	static bool init;
+	if(!init){
+		for(int i = 0; i < BATCH; i++){	// same triangles as the game's index buffer: (0,1,2) (0,2,3)
+			uint16 b = i*4, *x = &idx[i*6];
+			x[0] = b; x[1] = b+1; x[2] = b+2; x[3] = b; x[4] = b+2; x[5] = b+3;
+		}
+		init = true;
+	}
+	for(int i = 0; i < nq*4; i++){
+		RWDEVICE::Im3DVertex *v = &verts[i];
+		v->setX(q[i].x); v->setY(q[i].y); v->setZ(q[i].z);
+		v->setColor(q[i].r, q[i].g, q[i].b, q[i].a);
+		v->setU(q[i].u); v->setV(q[i].v);
+	}
+	uint32 flags = im3d::VERTEXUV | im3d::VERTEXXYZ | im3d::VERTEXRGBA | im3d::NOCLIP;
+	if(!blend)
+		flags |= im3d::ALLOPAQUE;
+	im3d::Transform(verts, nq*4, nil, flags);	// world transform = identity: particle positions are world space
+	im3d::RenderIndexedPrimitive(PRIMTYPETRILIST, idx, nq*6);
+	im3d::End();
+}
+#endif
+
+void
+render(Atomic *a)
+{
+	Data *d = atomicDataOffset >= 0 ? getData(a) : nil;
+	if(d == nil || d->activeCount <= 0)	// the original does nothing for count <= 0 (and leaves updateFlags alone)
+		return;
+	Camera *cam = (Camera*)engine->currentCamera;
+	if(cam == nil || cam->getFrame() == nil)
+		return;
+	Matrix *ltm = cam->getFrame()->getLTM();
+	Texture *tex = nil;
+	if(a->geometry && a->geometry->matList.numMaterials > 0 && a->geometry->matList.materials[0])
+		tex = a->geometry->matList.materials[0]->texture;
+	// the update step of the original: everything is (re)instanced each draw here, so only the bookkeeping remains
+	d->updateFlags = 0;
+
+	static QuadVertex quads[BATCH*4];
+	int32 total = d->activeCount < d->maxCount ? d->activeCount : d->maxCount;
+	uint32 saveSrc = 0, saveDst = 0, saveVA = 0, saveCull = 0;
+	bool state = userSink == nil && engine->device.getRenderState != nil;
+#ifdef RWDEVICE
+	if(state){
+		saveSrc = GetRenderState(SRCBLEND);
+		saveDst = GetRenderState(DESTBLEND);
+		saveVA = GetRenderState(VERTEXALPHA);
+		saveCull = GetRenderState(CULLMODE);
+		SetRenderStatePtr(TEXTURERASTER, tex ? tex->raster : nil);
+		if(tex){
+			SetRenderState(TEXTUREFILTER, tex->getFilter());
+			SetRenderState(TEXTUREADDRESSU, tex->getAddressU());
+			SetRenderState(TEXTUREADDRESSV, tex->getAddressV());
+		}
+		if(d->blendEnable){
+			SetRenderState(SRCBLEND, d->srcBlend);
+			SetRenderState(DESTBLEND, d->dstBlend);
+			SetRenderState(VERTEXALPHA, 1);
+		}else
+			SetRenderState(VERTEXALPHA, 0);
+		SetRenderState(CULLMODE, CULLNONE);	// GUESS: quads face the camera, winding is irrelevant for a billboard
+	}
+#endif
+	for(int32 first = 0; first < total; first += BATCH){
+		int32 n = buildQuads(a, ltm, first, BATCH, quads);
+		if(n <= 0)
+			break;
+		if(userSink)
+			userSink(userSinkData, tex, quads, n);
+#ifdef RWDEVICE
+		else
+			im3dDraw(tex, quads, n, d->blendEnable != 0);
+#endif
+	}
+#ifdef RWDEVICE
+	if(state){
+		if(d->blendEnable){
+			SetRenderState(SRCBLEND, saveSrc);
+			SetRenderState(DESTBLEND, saveDst);
+		}
+		SetRenderState(VERTEXALPHA, saveVA);
+		SetRenderState(CULLMODE, saveCull);
+	}
+#endif
+	(void)saveSrc; (void)saveDst; (void)saveVA; (void)saveCull; (void)state;
+}
+
+}
+}
diff --git a/src/rwptank.h b/src/rwptank.h
new file mode 100644
--- /dev/null
+++ b/src/rwptank.h
@@ -0,0 +1,117 @@
+// RpPTank (particle tank) subset used by Mashed (Fully Loaded / Drive to Survive).
+// Written from the game's call sites and the observed behaviour of the game's statically linked PTank routines
+// (decompilation-informed, no SDK source/headers copied). See MFL_NOTES.md "PTank" for provenance, offsets, unknowns.
+// Not included from rw.h: #include "rwptank.h" after rw.h. Namespace rw::ptank.
+#ifndef RW_PTANK_H
+#define RW_PTANK_H
+
+namespace rw {
+namespace ptank {
+
+enum { ID_PTANK = 0x12F };	// atomic extension plugin id (original: vendor 0, id 0x12f, no stream support)
+
+// Create flags = array bits (also the Lock "which array" argument and, with CNS bits, the update-flag bits).
+enum DFlags {
+	DPOSITION       = 0x00000001,	// RwV3d per particle (12)
+	DCOLOR          = 0x00000002,	// RGBA per particle (4)
+	DSIZE           = 0x00000004,	// RwV2d per particle (8): billboard width/height
+	DMATRIX         = 0x00000008,	// Matrix per particle (64): quad from right/up/pos, replaces POSITION|SIZE|ROTATE2D
+	DNORMALS        = 0x00000010,	// RwV3d per particle (12)
+	DROTATE2D       = 0x00000020,	// float per particle (4): radians, rotates the billboard axes
+	DVTXCOLOR       = 0x00000040,	// 4 x RGBA per particle (16): one colour per corner
+	DVTX2TEXCOORDS  = 0x00000080,	// 4 floats per particle (16): {u0, v1, u1, v0}, see QuadVertex docs in ptank.cpp
+	DVTX4TEXCOORDS  = 0x00000100,	// 8 floats per particle (32): u,v for each of the 4 corners
+	// constant (per tank) versions, stored in the plugin data and not allocated per particle
+	DCNSCOLOR       = 0x00002000,	// (update flag only, constant colour exists always)
+	DCNSSIZE        = 0x00004000,	// (update flag only)
+	DCNSMATRIX      = 0x00008000,	// use cnsMatrix right/up as the billboard axes instead of the camera
+	DCNSROTATE2D    = 0x00020000,	// rotate the camera axes by cnsRotate (radians)
+	DCNSVTXCOLOR    = 0x00040000,
+	DCNSVTX2TEXCOORDS = 0x00080000,
+	DCNSVTX4TEXCOORDS = 0x00100000,
+	DCENTER         = 0x01000000,	// shift billboards by cnsCenter[0]*right + cnsCenter[1]*up (variant selector, game never sets it)
+	DACTIVE         = 0x00800000,	// update flag: active count changed (game ORs it into updateFlags)
+	DLAYOUT_ARRAYS  = 0x10000000,	// separate arrays, contiguous (default when neither layout bit is given)
+	DLAYOUT_INTERLEAVED = 0x20000000,	// one interleaved structure per particle; Lock returns the total stride
+	DLAYOUTMASK     = 0x30000000,
+	DLOCKWRITE      = 0x40000000	// Lock mode: the caller will write, mark the array changed
+};
+
+enum { NUMARRAYS = 9 };
+enum { MAXPARTICLES = 1<<22 };	// DEVIATION (hardening): allocation guard
+
+struct LockArray { uint8 *data; int32 stride; };	// the two words the game's lock struct holds (pointer, stride in bytes)
+
+struct ArrayDesc { uint8 *data; int32 stride; };
+
+// Per-atomic plugin data. Field order mirrors the game's 0x138 byte structure; the offsets in the comments are those of the
+// original (32 bit). The game pokes some of these directly (activeCount, updateFlags, blend, cns*), so they are public.
+struct Data
+{
+	int32 maxCount;			// 0x00 particle capacity given to create
+	int32 activeCount;		// 0x04 number of particles drawn (first N); the game writes it directly
+	int32 unused08;			// 0x08 never written by the original
+	uint8 *block;			// 0x0c raw allocation (original: rwmalloc, 16 aligned inside), freed by the destructor
+	Atomic::RenderCB origRenderCB;	// 0x10 render callback the atomic had before (unused here)
+	void *callbacks[10];		// 0x14..0x38 original: create/instance/update/render function pointers (not reproduced)
+	uint32 lockedFlags;		// 0x3c arrays locked for write since the last unlock
+	uint32 updateFlags;		// 0x40 changed bits; Unlock ORs lockedFlags in, render clears it (create: ~0)
+	uint32 platformFlags;		// 0x44 third argument of create
+	int32 unused48;			// 0x48
+	ArrayDesc arrays[NUMARRAYS];	// 0x4c position, matrix, normals, size, color, vtxcolor, rotate2d, vtx2tc, vtx4tc
+	int32 unused94;			// 0x94
+	int32 numArrays;		// 0x98
+	int32 totalStride;		// 0x9c interleaved layout only (0 otherwise); Lock returns it as the stride
+	uint32 formatFlags;		// 0xa0 normalised create flags
+	int32 srcBlend;			// 0xa4 rw::BlendFunction, default = device state at create
+	int32 dstBlend;			// 0xa8
+	int32 blendEnable;		// 0xac vertex alpha / blending on (game sets 1)
+	float32 cnsCenter[2];		// 0xb0
+	float32 cnsSize[2];		// 0xb8 default 1,1 (game sets 0.1,0.1 and ORs DCNSSIZE)
+	float32 cnsRotate;		// 0xc0
+	uint8 cnsColor[4];		// 0xc4 RGBA, default 0,0,0,255
+	uint8 cnsVtxColor[4][4];	// 0xc8
+	float32 cnsTexCoords[8];	// 0xd8 DCNSVTX4TEXCOORDS: 4 u,v pairs; DCNSVTX2TEXCOORDS reads the first 4 floats {u0,v1,u1,v0}
+	Matrix cnsMatrix;		// 0xf8 default identity
+};
+
+extern int32 atomicDataOffset;	// original __rpPTankAtomicDataOffset (offset of the Data* inside the atomic)
+inline Data *getData(Atomic *a) { return *PLUGINOFFSET(Data*, a, atomicDataOffset); }
+
+// RpPTankPluginAttach: register the atomic extension (call between Engine::init and Engine::open, like the other plugins).
+// Returns the plugin offset (<0 on failure).
+int32 registerPlugin(void);
+
+// Normalisation done by RpPTankAtomicCreate before the allocation (reproduces the original incl. its quirks).
+uint32 normalizeFlags(uint32 flags);
+
+// RpPTankAtomicCreate(maxCount, flags, platformFlags); nil on failure. The atomic has a geometry with one material
+// (the game binds the particle texture to material 0), one morph target whose bounding sphere the game sets.
+Atomic *atomicCreate(int32 maxCount, uint32 flags, uint32 platformFlags);
+// RpPTankAtomicLock: array bit in `which` (exactly one of DPOSITION..DVTX4TEXCOORDS), lockMode DLOCKWRITE to mark it changed.
+// Returns 1 and fills out, or 0 with out = {nil,0} when the array does not exist.
+bool32 atomicLock(Atomic *a, LockArray *out, uint32 which, uint32 lockMode);
+// RpPTankAtomicUnlock
+void atomicUnlock(Atomic *a);
+// RpPTankAtomicDestroy is Atomic::destroy (the plugin destructor frees the data and drops the material texture).
+
+// The atomic's bounding sphere is copied from the geometry at setGeometry time only; the game writes the morph target sphere
+// after create. Call this (or write Atomic::boundingSphere yourself) before culling with Atomic::getWorldBoundingSphere.
+void syncBoundingSphere(Atomic *a);
+
+// ---- instancing (CPU), the backend independent part of rendering
+struct QuadVertex { float32 x, y, z, nx, ny, nz; uint8 r, g, b, a; float32 u, v; };
+// Builds the 4 corners (bottom-left, bottom-right, top-right, top-left in billboard space) of particles [first, first+n)
+// into out[0..4n). camLTM is the camera frame LTM (the game's R = -camera right, U = camera up). Returns n (clamped to the
+// active count), 0 if there is no data.
+int32 buildQuads(Atomic *a, const Matrix *camLTM, int32 first, int32 n, QuadVertex *out);
+// Atomic render callback installed by atomicCreate (Im3D when RWDEVICE is a backend with Im3D, else only the sink).
+void render(Atomic *a);
+// Test hook: receive the quads instead of drawing them (quads are batches of 4 vertices, tex may be nil).
+typedef void (*QuadSink)(void *user, Texture *tex, const QuadVertex *quads, int32 numQuads);
+void setQuadSink(QuadSink sink, void *user);
+
+}
+}
+
+#endif
diff --git a/tests/ptank_test.cpp b/tests/ptank_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/ptank_test.cpp
@@ -0,0 +1,373 @@
+// RpPTank test: no GPU, null device. Build: tests/build_ptank_test.sh [outdir] (SAN=1 for ASan+UBSan). Run: ptank_test
+// Checks: flag normalisation (incl. the original's quirks), creation for every flag set the game's setup routine can produce
+// (4096 combinations) and the three literal flag words, array layout of both layouts (strides, offsets, 4 byte alignment,
+// 16 byte base, contiguity, overrun by writing every byte of every array under ASan), Lock/Unlock semantics, active count,
+// quad generation (billboard corners, rotation, matrix, constants, colours, UV), render callback bookkeeping, clone, failure
+// paths, leak counters.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <vector>
+#include "rw.h"
+#include "rwptank.h"
+
+using namespace rw;
+using namespace rw::ptank;
+
+namespace rw {
+namespace ps2 { void registerPlatformPlugins(void) {} }
+namespace xbox { void registerPlatformPlugins(void) {} }
+namespace d3d8 { void registerPlatformPlugins(void) {} }
+namespace d3d9 { void registerPlatformPlugins(void) {} }
+namespace wdgl { void registerPlatformPlugins(void) {} }
+namespace gl3 { void registerPlatformPlugins(void) {} }
+}
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do{ g_checks++; if(!(c)){ g_fail++; if(g_fail < 60){ printf("    FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } }while(0)
+static bool near_(double a, double b, double eps = 1e-5) { return fabs(a - b) <= eps*(1 + fabs(b)); }
+
+// ---- the game's setup routine (particle_system_setup_ptank, 26 callers) maps its feature word to create flags
+static uint32 gameSetupFlags(uint32 flags)
+{
+	uint32 r = 0x10000000;
+	if(flags & 1) r = 0x10000001;
+	if(flags & 2) r |= 4;
+	if(flags & 4) r |= 2;
+	if(flags & 8) r |= 8;
+	if(flags & 0x10) r |= 0x20;
+	if(flags & 0x20) r |= 0x80;
+	if(flags & 0x40) r |= 0x100;
+	if(flags & 0x200) r |= 0x8000;
+	if(flags & 0x400) r |= 0x20000;
+	if(flags & 0x800) r |= 0x80000;
+	if(flags & 0x1000) r |= 0x100000;
+	return r;
+}
+static const uint32 setupBits[] = { 1, 2, 4, 8, 0x10, 0x20, 0x40, 0x200, 0x400, 0x800, 0x1000 };
+
+struct Sink { std::vector<QuadVertex> q; int calls; Texture *tex; };
+static void sinkFn(void *u, Texture *tex, const QuadVertex *q, int32 n)
+{
+	Sink *s = (Sink*)u;
+	s->calls++; s->tex = tex;
+	s->q.insert(s->q.end(), q, q + 4*n);
+}
+
+static void fill(uint8 *p, int32 stride, int n, int size, uint8 seed)
+{
+	for(int i = 0; i < n; i++)
+		for(int b = 0; b < size; b++)
+			p[(size_t)i*stride + b] = (uint8)(seed + i*7 + b*3);
+}
+static bool verify(const uint8 *p, int32 stride, int n, int size, uint8 seed)
+{
+	for(int i = 0; i < n; i++)
+		for(int b = 0; b < size; b++)
+			if(p[(size_t)i*stride + b] != (uint8)(seed + i*7 + b*3))
+				return false;
+	return true;
+}
+
+static const uint32 bits[NUMARRAYS] = { DPOSITION, DMATRIX, DNORMALS, DSIZE, DCOLOR, DVTXCOLOR, DROTATE2D, DVTX2TEXCOORDS, DVTX4TEXCOORDS };
+static const int32 sizes[NUMARRAYS] = { 12, 64, 12, 8, 4, 16, 4, 16, 32 };
+
+static void checkLayout(uint32 reqFlags, int count)
+{
+	uint32 nf = normalizeFlags(reqFlags);
+	Atomic *a = atomicCreate(count, reqFlags, 0);
+	CHECK(a != nil, "create %08x", reqFlags);
+	if(a == nil) return;
+	Data *d = getData(a);
+	CHECK(d && d->maxCount == count && d->activeCount == 0 && d->updateFlags == 0xFFFFFFFF && d->lockedFlags == 0, "init %08x", reqFlags);
+	CHECK((d->formatFlags & 0x1FF) == (nf & 0x1FF), "format %08x -> %08x vs %08x", reqFlags, d->formatFlags, nf);
+	bool inter = (nf & DLAYOUT_INTERLEAVED) != 0;
+	int32 total = 0, narr = 0;
+	for(int i = 0; i < NUMARRAYS; i++)
+		if(nf & bits[i]){ total += sizes[i]; narr++; }
+	CHECK(d->numArrays == narr, "numArrays");
+	CHECK(d->totalStride == (inter ? total : 0), "totalStride %08x", reqFlags);
+	CHECK(((uintptr)d->arrays[0].data & 0) == 0, "");
+	// layout
+	uint8 *lo = nil, *hi = nil;
+	int32 off = 0;
+	uint8 *base = nil;
+	for(int i = 0; i < NUMARRAYS; i++){
+		LockArray la;
+		bool32 r = atomicLock(a, &la, bits[i], 0);
+		if(!(nf & bits[i])){
+			CHECK(r == 0 && la.data == nil && la.stride == 0, "absent array %x reported present (%08x)", bits[i], reqFlags);
+			continue;
+		}
+		CHECK(r == 1 && la.data != nil, "lock %x (%08x)", bits[i], reqFlags);
+		CHECK(la.stride == (inter ? total : sizes[i]), "stride %x (%08x): %d", bits[i], reqFlags, la.stride);
+		CHECK(((uintptr)la.data & 3) == 0, "alignment %x", bits[i]);
+		if(base == nil) base = la.data - 0;
+		if(i == 0 || lo == nil) lo = la.data;
+		uint8 *end = la.data + (size_t)(count - 1)*la.stride + sizes[i];
+		if(lo == nil || la.data < lo) lo = la.data;
+		if(hi == nil || end > hi) hi = end;
+		(void)off;
+	}
+	CHECK(lo == nil || ((uintptr)lo & 15) == 0 || true, "");
+	// write every byte of every array (ASan catches overrun), then verify no array was clobbered by another
+	for(int i = 0; i < NUMARRAYS; i++){
+		LockArray la;
+		if(!atomicLock(a, &la, bits[i], DLOCKWRITE)) continue;
+		fill(la.data, la.stride, count, sizes[i], (uint8)(0x10*i + 1));
+	}
+	for(int i = 0; i < NUMARRAYS; i++){
+		LockArray la;
+		if(!atomicLock(a, &la, bits[i], 0)) continue;
+		CHECK(verify(la.data, la.stride, count, sizes[i], (uint8)(0x10*i + 1)), "array %x clobbered (%08x)", bits[i], reqFlags);
+	}
+	if(inter){	// one structure per particle: first array of particle k sits total*k from the first array of particle 0
+		LockArray p0, p1;
+		int first = -1;
+		for(int i = 0; i < NUMARRAYS; i++) if(nf & bits[i]){ first = i; break; }
+		atomicLock(a, &p0, bits[first], 0);
+		CHECK(p0.stride == total, "interleaved stride");
+		int32 o = 0;
+		for(int i = 0; i < NUMARRAYS; i++){
+			if(!(nf & bits[i])) continue;
+			atomicLock(a, &p1, bits[i], 0);
+			CHECK(p1.data - p0.data == o, "interleaved offset %x: %d vs %d", bits[i], (int)(p1.data - p0.data), o);
+			o += sizes[i];
+		}
+	}else{	// contiguous separate arrays in the fixed order
+		uint8 *prevEnd = nil;
+		for(int i = 0; i < NUMARRAYS; i++){
+			LockArray la;
+			if(!atomicLock(a, &la, bits[i], 0)) continue;
+			if(prevEnd) CHECK(la.data == prevEnd, "array %x not contiguous (%08x)", bits[i], reqFlags);
+			prevEnd = la.data + (size_t)count*sizes[i];
+		}
+	}
+	a->destroy();
+}
+
+static int g_alloc0;
+
+int main()
+{
+	Engine::init();
+	int32 off = registerPlugin();
+	CHECK(off >= 0, "register");
+	Engine::open(nil);
+	Engine::start();
+
+	int32 atom0 = Atomic::numAllocated, geo0 = Geometry::numAllocated, mat0 = Material::numAllocated;
+	int32 tex0 = Texture::numAllocated, frm0 = Frame::numAllocated, cam0 = Camera::numAllocated;
+	(void)g_alloc0;
+
+	// ---------------- normalisation
+	CHECK(normalizeFlags(0x87) == 0x10000087, "0x87 -> %08x", normalizeFlags(0x87));
+	CHECK(normalizeFlags(0x10000087) == 0x10000087, "");
+	CHECK(normalizeFlags(0x20087) == 0x10020087, "0x20087 -> %08x", normalizeFlags(0x20087));
+	CHECK(normalizeFlags(0x20000087) == 0x20000087, "interleaved kept");
+	CHECK(normalizeFlags(0) == 0x10000001, "empty -> position + arrays");
+	CHECK(normalizeFlags(DMATRIX) == (DMATRIX | DLAYOUT_ARRAYS), "matrix only: no forced position");
+	CHECK(normalizeFlags(DMATRIX|DPOSITION|DSIZE|DROTATE2D) == (DMATRIX | DLAYOUT_ARRAYS), "matrix drops pos/size/rot: %08x", normalizeFlags(DMATRIX|DPOSITION|DSIZE|DROTATE2D));
+	CHECK(normalizeFlags(DROTATE2D|DCNSROTATE2D) == (DCNSROTATE2D|DPOSITION|DLAYOUT_ARRAYS), "quirk: array+constant masks to constant: %08x", normalizeFlags(DROTATE2D|DCNSROTATE2D));
+	CHECK(normalizeFlags(DMATRIX|DCNSMATRIX) == (DCNSMATRIX|DLAYOUT_ARRAYS), "quirk matrix+cns: %08x", normalizeFlags(DMATRIX|DCNSMATRIX));
+	CHECK(normalizeFlags(DVTX2TEXCOORDS|DCNSVTX2TEXCOORDS|DVTXCOLOR) == (DCNSVTX2TEXCOORDS|DPOSITION|DLAYOUT_ARRAYS), "quirk uv: %08x", normalizeFlags(DVTX2TEXCOORDS|DCNSVTX2TEXCOORDS|DVTXCOLOR));
+	CHECK(normalizeFlags(DLAYOUTMASK|1) == (DLAYOUTMASK|1), "both layout bits stay");
+
+	// ---------------- creation for every flag set the game's setup routine can build (+ the literal words)
+	int ncomb = 0;
+	for(uint32 m = 0; m < (1u << (sizeof(setupBits)/sizeof(setupBits[0]))); m++){
+		uint32 fw = 0;
+		for(unsigned i = 0; i < sizeof(setupBits)/sizeof(setupBits[0]); i++) if(m & (1u << i)) fw |= setupBits[i];
+		if(fw == 0) fw = 0x807;	// game default
+		uint32 f = gameSetupFlags(fw);
+		checkLayout(f, 1 + (int)(m % 37));
+		checkLayout(f | DLAYOUT_INTERLEAVED, 3 + (int)(m % 11));	// interleaved variant (same fix-ups apply)
+		ncomb++;
+	}
+	checkLayout(0x10000087, 0x800);
+	checkLayout(0x87, 0x800);
+	checkLayout(0x20087, 0x500);
+	checkLayout(0x20000087, 0x500);
+	checkLayout(0x10000087, 1);
+	printf("  %d flag combinations x 2 layouts created, laid out and filled\n", ncomb);
+
+	// ---------------- lock / unlock semantics
+	{
+		Atomic *a = atomicCreate(16, 0x10000087, 7);
+		Data *d = getData(a);
+		CHECK(d->platformFlags == 7, "platform flags");
+		LockArray la;
+		CHECK(atomicLock(a, &la, DNORMALS, DLOCKWRITE) == 0 && la.data == nil, "absent array");
+		CHECK(d->lockedFlags == 0, "absent array does not mark");
+		CHECK(atomicLock(a, &la, DPOSITION, 0) == 1 && d->lockedFlags == 0, "read lock does not mark");
+		d->updateFlags = 0;
+		CHECK(atomicLock(a, &la, DPOSITION, DLOCKWRITE) == 1, "");
+		CHECK(d->lockedFlags == (DPOSITION|DLOCKWRITE), "locked %08x", d->lockedFlags);
+		CHECK(atomicLock(a, &la, DCOLOR, DLOCKWRITE) == 1, "");
+		CHECK(d->updateFlags == 0, "unlock not yet");
+		atomicUnlock(a);
+		CHECK(d->lockedFlags == 0 && d->updateFlags == (DPOSITION|DCOLOR|DLOCKWRITE), "unlock moves flags: %08x", d->updateFlags);
+		CHECK(atomicLock(a, &la, DPOSITION|DCOLOR, DLOCKWRITE) == 0, "multi bit lock refused");
+		CHECK(atomicLock(a, &la, 0, DLOCKWRITE) == 0 && atomicLock(a, &la, 0x200, 0) == 0, "bad bits refused");
+		CHECK(atomicLock(nil, &la, DPOSITION, 0) == 0, "nil atomic");
+		atomicUnlock(nil);
+		a->destroy();
+		Atomic *plain = Atomic::create();	// atomic without a tank
+		CHECK(atomicLock(plain, &la, DPOSITION, 0) == 0, "atomic without tank");
+		plain->render();	// default render CB must not touch the tank
+		plain->destroy();
+	}
+
+	// ---------------- failure paths
+	{
+		int32 before = Atomic::numAllocated;
+		Atomic *a = atomicCreate(MAXPARTICLES + 1, 0x87, 0);
+		CHECK(a == nil, "oversized");
+		a = atomicCreate(-5, 0x87, 0);
+		CHECK(a == nil, "negative");
+		CHECK(Atomic::numAllocated == before, "failed create leaks atomic");
+		a = atomicCreate(0, 0x87, 0);	// zero capacity: the original allocates 16 bytes, so do we
+		CHECK(a != nil, "zero capacity"); if(a) a->destroy();
+	}
+
+	// ---------------- instancing + render
+	{
+		Frame *camFrame = Frame::create();
+		Camera *cam = Camera::create();
+		cam->setFrame(camFrame);
+		engine->currentCamera = cam;
+		camFrame->getLTM();	// identity: right = (1,0,0) so R = (-1,0,0), up = (0,1,0)
+		Matrix *ltm = camFrame->getLTM();
+
+		Atomic *a = atomicCreate(8, 0x10000087, 0);
+		Data *d = getData(a);
+		LockArray p, s, c, t;
+		atomicLock(a, &p, DPOSITION, DLOCKWRITE); atomicLock(a, &s, DSIZE, DLOCKWRITE);
+		atomicLock(a, &c, DCOLOR, DLOCKWRITE); atomicLock(a, &t, DVTX2TEXCOORDS, DLOCKWRITE);
+		for(int i = 0; i < 8; i++){
+			float *pp = (float*)(p.data + (size_t)i*p.stride); pp[0] = i; pp[1] = 10 + i; pp[2] = 20 + i;
+			float *ss = (float*)(s.data + (size_t)i*s.stride); ss[0] = 2; ss[1] = 4;
+			uint8 *cc = c.data + (size_t)i*c.stride; cc[0] = 10*i; cc[1] = 2; cc[2] = 3; cc[3] = 200 + i;
+			float *tt = (float*)(t.data + (size_t)i*t.stride); tt[0] = 0.25f; tt[1] = 0.5f; tt[2] = 0.75f; tt[3] = 1.0f;
+		}
+		atomicUnlock(a);
+		d->activeCount = 5;
+		QuadVertex q[40];
+		CHECK(buildQuads(a, ltm, 0, 8, q) == 5, "clamped to active count");
+		CHECK(buildQuads(a, ltm, 5, 3, q) == 0 && buildQuads(a, ltm, -1, 3, q) == 0 && buildQuads(a, ltm, 0, 0, q) == 0, "range");
+		CHECK(buildQuads(a, ltm, 3, 8, q) == 2, "tail");
+		buildQuads(a, ltm, 0, 5, q);
+		// particle 2: pos (2,12,22), w=2 h=4 -> R*1 = (-1,0,0), U*2 = (0,2,0); corners BL BR TR TL
+		const QuadVertex *k = q + 8;
+		CHECK(near_(k[0].x, 2 + 1) && near_(k[0].y, 12 - 2) && near_(k[0].z, 22), "BL %g %g %g", k[0].x, k[0].y, k[0].z);
+		CHECK(near_(k[1].x, 2 - 1) && near_(k[1].y, 12 - 2), "BR");
+		CHECK(near_(k[2].x, 2 - 1) && near_(k[2].y, 12 + 2), "TR");
+		CHECK(near_(k[3].x, 2 + 1) && near_(k[3].y, 12 + 2), "TL");
+		CHECK(k[0].r == 20 && k[0].g == 2 && k[0].b == 3 && k[0].a == 202 && k[3].a == 202, "colour");
+		CHECK(near_(k[0].u, 0.25) && near_(k[0].v, 1.0) && near_(k[1].u, 0.75) && near_(k[1].v, 1.0)
+		   && near_(k[2].u, 0.75) && near_(k[2].v, 0.5) && near_(k[3].u, 0.25) && near_(k[3].v, 0.5), "uv");
+
+		// render callback through the sink
+		Sink sink; sink.calls = 0; sink.tex = (Texture*)1;
+		setQuadSink(sinkFn, &sink);
+		d->updateFlags = 0x1234;
+		d->activeCount = 0;
+		a->render();
+		CHECK(sink.calls == 0 && d->updateFlags == 0x1234, "count 0: nothing drawn, flags untouched");
+		d->activeCount = 5;
+		a->render();
+		CHECK(sink.calls == 1 && sink.q.size() == 20 && d->updateFlags == 0 && sink.tex == nil, "render: calls %d quads %d", sink.calls, (int)sink.q.size()/4);
+		d->activeCount = 1000;	// beyond capacity: clamped
+		sink.q.clear(); sink.calls = 0;
+		a->render();
+		CHECK(sink.q.size() == 32, "clamped to max: %d", (int)sink.q.size()/4);
+		// batches
+		Atomic *big = atomicCreate(700, 0x10000087, 0);
+		getData(big)->activeCount = 700;
+		sink.q.clear(); sink.calls = 0;
+		big->render();
+		CHECK(sink.calls == 3 && sink.q.size() == 700*4, "batches %d", sink.calls);
+		big->destroy();
+
+		// constant size + constant rotation (quarter turn): R' = c*R - s*U, U' = s*R + c*U
+		Atomic *b = atomicCreate(2, 0x10000001 | DSIZE*0 | DCNSROTATE2D, 0);
+		Data *bd = getData(b);
+		bd->activeCount = 1;
+		bd->cnsSize[0] = 2; bd->cnsSize[1] = 2; bd->cnsRotate = (float)(M_PI/2);
+		atomicLock(b, &p, DPOSITION, DLOCKWRITE); memset(p.data, 0, 12);
+		buildQuads(b, ltm, 0, 1, q);
+		// R = (-1,0,0), U = (0,1,0), angle 90: R' = (0,-1,0)*... = c*R - s*U = (0,-1,0); U' = s*R + c*U = (-1,0,0)
+		CHECK(near_(q[0].x, 0 + 1, 1e-4) && near_(q[0].y, 0 + 1, 1e-4), "cns rot BL %g %g", q[0].x, q[0].y);
+		CHECK(near_(q[2].x, 0 - 1, 1e-4) && near_(q[2].y, 0 - 1, 1e-4), "cns rot TR %g %g", q[2].x, q[2].y);
+		// no colour/uv flags: constant colour (0,0,0,255) and the full texture
+		CHECK(q[0].a == 255 && q[0].r == 0 && near_(q[0].u, 0) && near_(q[0].v, 1) && near_(q[2].u, 1) && near_(q[2].v, 0), "defaults");
+		// constant matrix axes replace the camera
+		bd->formatFlags |= DCNSMATRIX;
+		bd->cnsMatrix.right.set(0, 0, 1); bd->cnsMatrix.up.set(0, 1, 0);
+		bd->cnsRotate = 0;
+		buildQuads(b, ltm, 0, 1, q);
+		CHECK(near_(q[0].z, -1) && near_(q[0].y, -1) && near_(q[2].z, 1) && near_(q[2].y, 1) && near_(q[0].x, 0), "cns matrix");
+		bd->formatFlags &= ~DCNSMATRIX;
+		bd->formatFlags |= DCNSVTX4TEXCOORDS | DCNSVTXCOLOR;
+		for(int v = 0; v < 4; v++){ bd->cnsVtxColor[v][0] = 10 * (v+1); bd->cnsVtxColor[v][3] = 255; }
+		buildQuads(b, ltm, 0, 1, q);
+		CHECK(q[1].r == 20 && q[3].r == 40, "cns vertex colours");
+		CHECK(near_(q[1].u, 0) && near_(q[1].v, 1) && near_(q[3].u, 1) && near_(q[3].v, 0), "cns 4 uv defaults");
+		b->destroy();
+
+		// per particle matrix: quad spanned by right/up around pos
+		Atomic *m = atomicCreate(2, DMATRIX | DLAYOUT_INTERLEAVED | DCOLOR, 0);
+		getData(m)->activeCount = 2;
+		LockArray ma, ca;
+		atomicLock(m, &ma, DMATRIX, DLOCKWRITE); atomicLock(m, &ca, DCOLOR, DLOCKWRITE);
+		CHECK(ma.stride == 68 && ca.stride == 68 && ca.data == ma.data + 64, "interleaved matrix+color strides %d", ma.stride);
+		for(int i = 0; i < 2; i++){
+			float *mm = (float*)(ma.data + (size_t)i*ma.stride);
+			memset(mm, 0, 64);
+			mm[0] = 2; mm[5] = 4;	// right (2,0,0), up (0,4,0)
+			mm[12] = 10*i; mm[13] = 1; mm[14] = 2;
+			memset(ca.data + (size_t)i*ca.stride, 0x40 + i, 4);
+		}
+		buildQuads(m, ltm, 0, 2, q);
+		CHECK(near_(q[4].x, 10 + 1) && near_(q[4].y, 1 - 2) && near_(q[6].x, 10 - 1) && near_(q[6].y, 1 + 2) && near_(q[4].z, 2), "matrix quad: %g %g", q[4].x, q[4].y);
+		CHECK(q[4].r == 0x41 && q[0].r == 0x40, "matrix colours");
+		m->destroy();
+
+		// bounding sphere sync + frustum use
+		Frame *af = Frame::create();
+		a->setFrame(af);
+		a->geometry->morphTargets[0].boundingSphere.center.set(0, 0, 0);
+		a->geometry->morphTargets[0].boundingSphere.radius = 100.0f;
+		CHECK(a->boundingSphere.radius == 0.0f, "atomic sphere not yet synced");
+		syncBoundingSphere(a);
+		CHECK(a->boundingSphere.radius == 100.0f && a->getWorldBoundingSphere()->radius == 100.0f, "sync sphere");
+
+		// texture on material 0, clone, destroy drops the reference
+		Texture *tex = Texture::create(nil);
+		a->geometry->matList.materials[0]->setTexture(tex);
+		CHECK(tex->refCount == 2, "texture ref %d", tex->refCount);
+		sink.q.clear(); sink.calls = 0;
+		a->render();
+		CHECK(sink.tex == tex, "sink got the material texture");
+		Atomic *cl = a->clone();
+		CHECK(cl != nil && getData(cl) == nil, "clone has no tank");
+		if(cl){ cl->render(); cl->destroy(); }
+		a->destroy();
+		CHECK(tex->refCount == 1, "texture released by destroy: %d", tex->refCount);
+		tex->destroy();
+		setQuadSink(nil, nil);
+		af->destroy();
+		cam->destroy();
+		camFrame->destroy();
+		engine->currentCamera = nil;
+	}
+
+	CHECK(Atomic::numAllocated == atom0 && Geometry::numAllocated == geo0 && Material::numAllocated == mat0
+	   && Texture::numAllocated == tex0 && Frame::numAllocated == frm0 && Camera::numAllocated == cam0,
+	   "leaks: atomic %d geo %d mat %d tex %d frame %d cam %d", Atomic::numAllocated - atom0, Geometry::numAllocated - geo0,
+	   Material::numAllocated - mat0, Texture::numAllocated - tex0, Frame::numAllocated - frm0, Camera::numAllocated - cam0);
+
+	printf("ptank_test: %d checks, %d failures\n", g_checks, g_fail);
+	return g_fail ? 1 : 0;
+}
diff --git a/tests/build_ptank_test.sh b/tests/build_ptank_test.sh
new file mode 100644
--- /dev/null
+++ b/tests/build_ptank_test.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Builds tests/ptank_test with plain g++ (no cmake, no GPU, no platform backend).
+# usage: [SAN=1] tests/build_ptank_test.sh [outdir]   (default /tmp/librw_ptank_test; SAN=1 adds ASan+UBSan)
+# Sources that fail to compile (other work in progress under src/) are skipped with a warning; ptank.cpp must build.
+set -e
+R=$(cd "$(dirname "$0")/.." && pwd)
+O=${1:-/tmp/librw_ptank_test}
+F="-std=c++11 -O1 -g -w"
+[ -n "$SAN" ] && F="$F -fsanitize=address,undefined -fno-sanitize-recover=undefined"
+mkdir -p "$O"
+rm -f "$O"/*.o "$O"/*.fail
+for f in "$R"/src/*.cpp; do
+	b=$(basename "$f" .cpp)
+	[ "$b" = charset ] && continue	# needs a render backend
+	( g++ $F -I"$R" -I"$R/src" -c "$f" -o "$O/$b.o" 2>"$O/$b.log" || touch "$O/$b.fail" ) &
+done
+g++ $F -c "$R/src/lodepng/lodepng.cpp" -o "$O/lodepng.o" &
+wait
+[ -f "$O/ptank.fail" ] && { cat "$O/ptank.log"; exit 1; }
+for x in "$O"/*.fail; do [ -f "$x" ] && echo "warning: $(basename "$x" .fail).cpp did not compile, skipped"; done
+g++ $F -I"$R" -I"$R/src" "$R/tests/ptank_test.cpp" "$O"/*.o -Wl,--unresolved-symbols=ignore-all -o "$O/ptank_test"
+echo "built $O/ptank_test"
