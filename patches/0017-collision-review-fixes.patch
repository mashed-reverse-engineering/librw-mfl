+	for(int a = 0; a < 3; a++) L[6+a] = L[3+a] == 0.0f ? 0.0f : 1.0f/L[3+a];
+	const float *s = &line.start.x, *e = &line.end.x;
+	for(int a = 0; a < 3; a++){ float m = fabsf(s[a]) < fabsf(e[a]) ? e[a] : s[a]; L[9+a] = fabsf(m) * 1e-6f; }
